---
// src/pages/japanese-comprehension-test/index.astro
// Phase 1 — JCT (Japanese Comprehension Test): skeleton + working mock flow.
// Steps: self-assessment (Lv1-7) -> media questions (quiz + 1-10 scale) -> result.
// Copy is bilingual: Indonesian (site language) primary, Japanese as the
// second line — same two-tier pattern as the quest dialogue (idText/jpText).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '../../utils/breadcrumb-schema';
import levelsData from '../../data/jct/levels.json';
import scaleData from '../../data/jct/comprehension-scale.json';
import questionsData from '../../data/jct/questions.mock.json';
import '../../styles/pages/jct/jct.css';

// ========== TYPE DEFINITIONS ==========
interface JctLevel {
  readonly level: number;
  readonly idText: string;
  readonly jpText: string;
}

interface JctScaleItem {
  readonly value: number;
  readonly short: string;
  readonly idText: string;
  readonly jpText: string;
}

// ========== DATA ==========
const levels = levelsData as JctLevel[];
const scale = scaleData as JctScaleItem[];

// Client payload is an explicit allowlist: only the fields the inline script
// reads are serialised into the HTML. `answer` has to ship to the browser for
// grading, but any other authoring metadata (notes, explanations, source
// credits) stays out of the page source.
const questions = questionsData.map(question => ({
  id: question.id,
  type: question.type,
  level: question.level,
  media: question.media,
  prompt: question.prompt,
  options: question.options,
  answer: question.answer,
}));
const totalQuestions = questions.length;

// ========== SEO ==========
const seoTitle =
  'Japanese Comprehension Test (JCT) — Ukur Pemahaman Bahasa Jepang Aslimu・語楽道 GoRakuDo';
const seoDescription =
  'Tes pemahaman bahasa Jepang berbasis media asli, bukan hafalan tata bahasa. Tentukan levelmu (Lv 1–7), kerjakan soal listening dan reading, lalu dapatkan rute belajar yang paling cocok untukmu.';

const siteUrl = String(Astro.site || 'https://gorakudo.org');
const breadcrumbSchema = generateBreadcrumbSchema({
  items: [
    { title: 'Beranda', url: '/', isActive: false },
    {
      title: 'Japanese Comprehension Test',
      url: '/japanese-comprehension-test',
      isActive: true,
    },
  ],
  siteUrl,
});
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  pageType='website'
  lang='id'
  breadcrumbSchema={breadcrumbSchema}
>
  <main
    class='jct-page'
    role='main'
    aria-label='Japanese Comprehension Test'
    data-jct
  >
    <!-- ========== HEADER ========== -->
    <header class='jct-header'>
      <p class='jct-marker' aria-hidden='true'>/// JCT_ONLINE ///</p>
      <h1 class='jct-title'>
        Japanese Comprehension Test
        <span class='jct-title-abbr' aria-hidden='true'>JCT</span>
      </h1>
      <p class='jct-subtitle'>
        Ukur <strong>pemahaman bahasa Jepang aslimu</strong> lewat media asli —
        bukan hafalan tata bahasa.
      </p>
      <p class='jct-subtitle-jp' lang='ja'>
        生メディアからあなたの「本当の日本語把握力」を測定します
      </p>
    </header>

    <!-- ========== STEP INDICATOR ========== -->
    <ol class='jct-steps' aria-label='Tahapan tes'>
      <li class='jct-step is-active' data-jct-step='start' aria-current='step'>
        <span class='jct-step-num'>01</span>
        <span class='jct-step-name'>Penilaian Diri</span>
      </li>
      <li class='jct-step' data-jct-step='test'>
        <span class='jct-step-num'>02</span>
        <span class='jct-step-name'>Tes Media</span>
      </li>
      <li class='jct-step' data-jct-step='result'>
        <span class='jct-step-num'>03</span>
        <span class='jct-step-name'>Hasil</span>
      </li>
    </ol>

    <p class='jct-visually-hidden' aria-live='polite' data-jct-live></p>

    <!-- ========== STEP 1: SELF-ASSESSMENT ========== -->
    <section
      class='jct-panel'
      data-jct-panel='start'
      aria-labelledby='jct-start-title'
      tabindex='-1'
    >
      <div class='jct-card jct-intro-card'>
        <h2 class='jct-card-title' id='jct-start-title'>
          Seberapa jauh kamu paham bahasa Jepang saat ini?
        </h2>
        <p class='jct-card-lead'>
          Pilih satu level yang paling mendekati perasaanmu. Jawaban ini tidak
          dinilai benar atau salah — kami hanya memakainya untuk membandingkan
          perkiraanmu dengan hasil tes nanti.
        </p>
      </div>

      <fieldset class='jct-level-group'>
        <legend class='jct-legend'>
          Perkiraan levelmu sekarang
          <span class='jct-legend-jp' lang='ja'>自己申告レベル</span>
        </legend>

        {levels.map(level => (
          <label class='jct-level'>
            <input
              class='jct-visually-hidden'
              type='radio'
              name='jct-self-level'
              value={level.level}
              data-jct-self-level
            />
            <span class='jct-level-badge'>Lv {level.level}</span>
            <span class='jct-level-body'>
              <span class='jct-level-id'>{level.idText}</span>
              <span class='jct-level-jp' lang='ja'>{level.jpText}</span>
            </span>
            <span class='jct-level-check' aria-hidden='true'>
              <svg
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='3'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <path d='M4 12.5l5 5L20 6.5'></path>
              </svg>
            </span>
          </label>
        ))}
      </fieldset>

      <div class='jct-actions'>
        <p class='jct-hint' data-jct-start-hint>
          Pilih satu level dulu untuk memulai.
        </p>
        <button
          class='jct-btn jct-btn-primary'
          type='button'
          data-jct-start
          disabled
        >
          <span>Mulai Tes</span>
          <span class='jct-btn-jp' lang='ja'>テスト開始</span>
          <span aria-hidden='true'>▶</span>
        </button>
      </div>
    </section>

    <!-- ========== STEP 2: MEDIA TEST ========== -->
    <section
      class='jct-panel'
      data-jct-panel='test'
      aria-labelledby='jct-test-title'
      tabindex='-1'
      hidden
    >
      <h2 class='jct-visually-hidden' id='jct-test-title'>
        Tes media
      </h2>

      <div class='jct-testbar'>
        <span class='jct-counter' data-jct-counter>Pertanyaan 1 / 4</span>
        <span class='jct-type-tag' data-jct-type>Listening</span>
      </div>
      <div
        class='jct-progress'
        role='progressbar'
        aria-valuemin='0'
        aria-valuemax='100'
        aria-valuenow='0'
        aria-label='Kemajuan tes'
        data-jct-progressbar
      >
        <span class='jct-progress-fill' data-jct-progress></span>
      </div>

      <article class='jct-card jct-media-card'>
        <div class='jct-media-slot' data-jct-media></div>
        <p class='jct-media-note'>
          Media contoh untuk fase mock. Sumber asli (YouTube / X / Aozora)
          dipasang pada fase berikutnya.
        </p>
      </article>

      <article class='jct-card jct-question-card'>
        <p class='jct-q-index' data-jct-q-index>Pertanyaan 01</p>
        <h3 class='jct-q-prompt' data-jct-prompt></h3>
        <p class='jct-q-prompt-jp' lang='ja' data-jct-prompt-jp></p>

        <fieldset class='jct-option-group'>
          <legend class='jct-legend'>
            Pilih satu jawaban
            <span class='jct-legend-jp' lang='ja'>内容理解クイズ</span>
          </legend>
          <div class='jct-options' data-jct-options></div>
        </fieldset>
      </article>

      <article class='jct-card jct-scale-card'>
        <h3 class='jct-scale-title'>
          Seberapa besar porsi yang kamu pahami?
        </h3>
        <p class='jct-scale-lead'>
          Skala <em>Comprehension Amount</em> (Refold). Nilai 1–10 untuk
          perasaanmu sendiri setelah menyimak media di atas.
        </p>

        <fieldset class='jct-scale-group'>
          <legend class='jct-legend'>
            Skala pemahaman
            <span class='jct-legend-jp' lang='ja'>体感理解度</span>
          </legend>

          {scale.map(item => (
            <label class='jct-scale-option'>
              <input
                class='jct-visually-hidden'
                type='radio'
                name='jct-scale'
                value={item.value}
                data-jct-scale
              />
              <span class='jct-scale-num'>{item.value}</span>
              <span class='jct-scale-body'>
                <span class='jct-scale-short'>{item.short}</span>
                <span class='jct-scale-jp' lang='ja'>{item.jpText}</span>
              </span>
            </label>
          ))}
        </fieldset>
      </article>

      <div class='jct-actions'>
        <p class='jct-hint' data-jct-next-hint>
          Pilih jawaban dan skala pemahaman untuk melanjutkan.
        </p>
        <button
          class='jct-btn jct-btn-primary'
          type='button'
          data-jct-next
          disabled
        >
          <span data-jct-next-label>Lanjut</span>
          <span aria-hidden='true'>▶</span>
        </button>
      </div>
    </section>

    <!-- ========== STEP 3: RESULT ========== -->
    <section
      class='jct-panel'
      data-jct-panel='result'
      aria-labelledby='jct-result-title'
      tabindex='-1'
      hidden
    >
      <div class='jct-card jct-result-head'>
        <p class='jct-marker jct-marker-small' aria-hidden='true'>
          /// HASIL_ANALISIS ///
        </p>
        <h2 class='jct-result-title' id='jct-result-title'>Hasil Tesmu</h2>
        <p class='jct-result-lead' data-jct-result-lead></p>
      </div>

      <div class='jct-level-cards'>
        <div class='jct-card jct-level-card' data-jct-level-card='listening'>
          <p class='jct-level-card-label'>
            Listening
            <span class='jct-level-card-jp' lang='ja'>リスニング</span>
          </p>
          <p class='jct-level-card-value'>
            <span class='jct-level-card-lv'>Lv</span>
            <span class='jct-level-card-num' data-jct-level-listening>–</span>
          </p>
          <p class='jct-level-card-note' data-jct-note-listening></p>
        </div>

        <div class='jct-card jct-level-card' data-jct-level-card='reading'>
          <p class='jct-level-card-label'>
            Reading
            <span class='jct-level-card-jp' lang='ja'>リーディング</span>
          </p>
          <p class='jct-level-card-value'>
            <span class='jct-level-card-lv'>Lv</span>
            <span class='jct-level-card-num' data-jct-level-reading>–</span>
          </p>
          <p class='jct-level-card-note' data-jct-note-reading></p>
        </div>
      </div>

      <div class='jct-card jct-gap-card'>
        <h3 class='jct-gap-title'>Analisis selisih</h3>
        <p class='jct-gap-headline' data-jct-gap-headline></p>
        <ul class='jct-gap-list' data-jct-gap-list></ul>
        <div class='jct-stat-row'>
          <span class='jct-stat'>
            <span class='jct-stat-label'>Jawaban benar</span>
            <span class='jct-stat-value' data-jct-stat-correct>–</span>
          </span>
          <span class='jct-stat'>
            <span class='jct-stat-label'>Rata-rata skala</span>
            <span class='jct-stat-value' data-jct-stat-scale>–</span>
          </span>
          <span class='jct-stat'>
            <span class='jct-stat-label'>Penilaian dirimu</span>
            <span class='jct-stat-value' data-jct-stat-self>–</span>
          </span>
        </div>
      </div>

      <div class='jct-result-actions'>
        <a
          class='jct-btn jct-btn-primary'
          href='/panduan-immersion-belajar-bahasa-jepang-dengan-otodidak'
        >
          <span>Rute Belajar yang Cocok untukmu</span>
          <span aria-hidden='true'>▶</span>
        </a>
        <button class='jct-btn jct-btn-ghost' type='button' data-jct-retry>
          <span>Ulangi Tes</span>
          <span aria-hidden='true'>↺</span>
        </button>
        <p class='jct-hint jct-hint-center'>
          Panduan immersion umum dulu — rute khusus per level menyusul bersama
          halaman Wiki.
        </p>
      </div>
    </section>

    <!-- ========== MEDIA TEMPLATES (cloned per question) ========== -->
    <template data-jct-template='youtube'>
      <div class='jct-yt'>
        <div class='jct-yt-screen'>
          <span class='jct-yt-platform'>YouTube</span>
          <span class='jct-yt-clip' data-field='clip'></span>
          <button
            class='jct-yt-play'
            type='button'
            data-jct-play
            aria-label='Putar sampel audio (mock)'
          >
            <svg
              class='jct-yt-icon jct-yt-icon-play'
              viewBox='0 0 24 24'
              fill='currentColor'
              aria-hidden='true'
            >
              <path d='M8 5.5v13l11-6.5z'></path>
            </svg>
            <svg
              class='jct-yt-icon jct-yt-icon-pause'
              viewBox='0 0 24 24'
              fill='currentColor'
              aria-hidden='true'
            >
              <path d='M7 5h4v14H7zM13 5h4v14h-4z'></path>
            </svg>
          </button>
          <p class='jct-yt-caption' data-field='caption'></p>
        </div>
        <div class='jct-yt-bar'>
          <span class='jct-yt-time' data-jct-time>0:00</span>
          <span class='jct-yt-track'>
            <span class='jct-yt-fill' data-jct-fill></span>
          </span>
          <span class='jct-yt-time' data-jct-total>0:00</span>
        </div>
      </div>
    </template>

    <template data-jct-template='x-post'>
      <div class='jct-xpost'>
        <div class='jct-xpost-head'>
          <span class='jct-xpost-avatar' data-field='initial' aria-hidden='true'
          ></span>
          <span class='jct-xpost-user'>
            <span class='jct-xpost-name' data-field='name'></span>
            <span class='jct-xpost-handle' data-field='handle'></span>
          </span>
          <span class='jct-xpost-platform'>X</span>
        </div>
        <p class='jct-xpost-text' lang='ja' data-field='text'></p>
      </div>
    </template>

    <template data-jct-template='aozora'>
      <div class='jct-aozora'>
        <div class='jct-aozora-head'>
          <span class='jct-aozora-work' data-field='work'></span>
          <span class='jct-aozora-author' data-field='author'></span>
        </div>
        <div class='jct-aozora-frame'>
          <p class='jct-aozora-text' lang='ja' data-field='text'></p>
        </div>
        <p class='jct-aozora-note'>
          Kutipan domain publik — ejaan kana mengikuti teks asli.
        </p>
      </div>
    </template>
  </main>
</BaseLayout>

<!-- ========== SCRIPTS ========== -->
<script is:inline define:vars={{ questions, totalQuestions }}>
  (() => {
    const root = document.querySelector('[data-jct]');
    if (!root) return;

    const panels = {
      start: root.querySelector('[data-jct-panel="start"]'),
      test: root.querySelector('[data-jct-panel="test"]'),
      result: root.querySelector('[data-jct-panel="result"]'),
    };
    const stepItems = root.querySelectorAll('[data-jct-step]');
    const live = root.querySelector('[data-jct-live]');

    const selfLevelInputs = root.querySelectorAll('[data-jct-self-level]');
    const startBtn = root.querySelector('[data-jct-start]');
    const startHint = root.querySelector('[data-jct-start-hint]');

    const counter = root.querySelector('[data-jct-counter]');
    const typeTag = root.querySelector('[data-jct-type]');
    const progressBar = root.querySelector('[data-jct-progressbar]');
    const progressFill = root.querySelector('[data-jct-progress]');
    const mediaSlot = root.querySelector('[data-jct-media]');
    const qIndex = root.querySelector('[data-jct-q-index]');
    const promptId = root.querySelector('[data-jct-prompt]');
    const promptJp = root.querySelector('[data-jct-prompt-jp]');
    const optionsBox = root.querySelector('[data-jct-options]');
    const scaleInputs = root.querySelectorAll('[data-jct-scale]');
    const nextBtn = root.querySelector('[data-jct-next]');
    const nextHint = root.querySelector('[data-jct-next-hint]');
    const nextLabel = root.querySelector('[data-jct-next-label]');

    const resultLead = root.querySelector('[data-jct-result-lead]');
    const levelListening = root.querySelector('[data-jct-level-listening]');
    const levelReading = root.querySelector('[data-jct-level-reading]');
    const noteListening = root.querySelector('[data-jct-note-listening]');
    const noteReading = root.querySelector('[data-jct-note-reading]');
    const gapHeadline = root.querySelector('[data-jct-gap-headline]');
    const gapList = root.querySelector('[data-jct-gap-list]');
    const statCorrect = root.querySelector('[data-jct-stat-correct]');
    const statScale = root.querySelector('[data-jct-stat-scale]');
    const statSelf = root.querySelector('[data-jct-stat-self]');
    const retryBtn = root.querySelector('[data-jct-retry]');

    // ========== STATE ==========
    const state = {
      selfLevel: 0,
      index: 0,
      optionIndex: -1,
      scaleValue: 0,
      answers: [],
    };

    // ========== HELPERS ==========
    const formatClock = seconds => {
      const total = Math.max(0, Math.round(seconds));
      const m = Math.floor(total / 60);
      const s = total % 60;
      return m + ':' + String(s).padStart(2, '0');
    };

    const clampLevel = value => Math.min(7, Math.max(1, Math.round(value)));

    const announce = message => {
      if (live) live.textContent = message;
    };

    // scrollIntoView is missing in some embedded/legacy engines — never let
    // a scroll nicety break the step transition.
    const scrollToTop = () => {
      if (typeof root.scrollIntoView === 'function') {
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    const showPanel = name => {
      Object.keys(panels).forEach(key => {
        const panel = panels[key];
        if (panel) panel.hidden = key !== name;
      });
      stepItems.forEach(item => {
        const active = item.dataset.jctStep === name;
        item.classList.toggle('is-active', active);
        if (active) {
          item.setAttribute('aria-current', 'step');
        } else {
          item.removeAttribute('aria-current');
        }
      });
    };

    // The clicked button disappears with its panel, so move focus to the
    // panel that replaced it — otherwise focus stays on a hidden node and
    // keyboard/screen-reader users lose their place.
    const focusPanel = name => {
      const panel = panels[name];
      if (panel) panel.focus({ preventScroll: true });
    };

    // ========== STEP 1 ==========
    const syncStartButton = () => {
      const ready = state.selfLevel > 0;
      startBtn.disabled = !ready;
      startHint.hidden = ready;
    };

    selfLevelInputs.forEach(input => {
      input.addEventListener('change', () => {
        state.selfLevel = Number(input.value) || 0;
        syncStartButton();
      });
    });

    // ========== STEP 2: MEDIA ==========
    // The mock player only animates a timeline; no audio is loaded in phase 1.
    let playerTimer = null;
    let playerElapsed = 0;
    let playerDuration = 15;
    let playerEls = null;

    const stopPlayer = () => {
      if (playerTimer !== null) {
        window.clearInterval(playerTimer);
        playerTimer = null;
      }
      if (playerEls) {
        playerEls.frame.classList.remove('is-playing');
        playerEls.playBtn.setAttribute('aria-label', 'Putar sampel audio (mock)');
      }
    };

    const paintPlayer = () => {
      if (!playerEls) return;
      const ratio = playerDuration > 0 ? playerElapsed / playerDuration : 0;
      playerEls.fill.style.width = Math.min(100, ratio * 100) + '%';
      playerEls.time.textContent = formatClock(playerElapsed);
    };

    const startPlayer = () => {
      if (!playerEls) return;
      if (playerElapsed >= playerDuration) playerElapsed = 0;
      playerEls.frame.classList.add('is-playing');
      playerEls.playBtn.setAttribute('aria-label', 'Jeda sampel audio (mock)');
      playerTimer = window.setInterval(() => {
        playerElapsed += 0.25;
        if (playerElapsed >= playerDuration) {
          playerElapsed = playerDuration;
          paintPlayer();
          stopPlayer();
          return;
        }
        paintPlayer();
      }, 250);
    };

    const buildMedia = question => {
      stopPlayer();
      playerEls = null;
      playerElapsed = 0;
      mediaSlot.textContent = '';

      const media = question.media || {};
      const template = root.querySelector(
        '[data-jct-template="' + media.kind + '"]'
      );
      if (!template) return;

      const fragment = template.content.cloneNode(true);
      const fields = {
        caption: media.label || '',
        clip: '',
        initial: '',
        name: media.name || '',
        handle: media.handle || '',
        text: media.text || '',
        work: media.work || '',
        author: media.author || '',
      };

      if (media.kind === 'youtube') {
        const start = Number(media.start) || 0;
        const end = Number(media.end) || 0;
        playerDuration = Math.max(1, end - start);
        fields.clip = formatClock(start) + ' – ' + formatClock(end);
      }
      if (media.kind === 'x-post') {
        fields.initial = (media.name || '?').slice(0, 1).toUpperCase();
      }

      fragment.querySelectorAll('[data-field]').forEach(node => {
        const key = node.dataset.field;
        node.textContent = fields[key] || '';
      });

      mediaSlot.append(fragment);

      if (media.kind !== 'youtube') return;

      const frame = mediaSlot.querySelector('.jct-yt');
      const playBtn = mediaSlot.querySelector('[data-jct-play]');
      const fill = mediaSlot.querySelector('[data-jct-fill]');
      const time = mediaSlot.querySelector('[data-jct-time]');
      const total = mediaSlot.querySelector('[data-jct-total]');
      if (!frame || !playBtn || !fill || !time || !total) return;

      total.textContent = formatClock(playerDuration);
      playerEls = { frame, playBtn, fill, time };
      paintPlayer();

      playBtn.addEventListener('click', () => {
        if (playerTimer !== null) {
          stopPlayer();
          return;
        }
        startPlayer();
      });
    };

    // ========== STEP 2: OPTIONS ==========
    const buildOptions = question => {
      optionsBox.textContent = '';
      (question.options || []).forEach((text, index) => {
        const label = document.createElement('label');
        label.className = 'jct-option';

        const input = document.createElement('input');
        input.className = 'jct-visually-hidden';
        input.type = 'radio';
        input.name = 'jct-option';
        input.value = String(index);

        const badge = document.createElement('span');
        badge.className = 'jct-option-badge';
        badge.setAttribute('aria-hidden', 'true');
        badge.textContent = String.fromCharCode(65 + index);

        const body = document.createElement('span');
        body.className = 'jct-option-text';
        body.lang = 'ja';
        body.textContent = text;

        label.append(input, badge, body);
        input.addEventListener('change', () => {
          state.optionIndex = index;
          syncNextButton();
        });
        optionsBox.append(label);
      });
    };

    // ========== STEP 2: QUESTION RENDER ==========
    const syncNextButton = () => {
      const ready = state.optionIndex >= 0 && state.scaleValue > 0;
      nextBtn.disabled = !ready;
      nextHint.hidden = ready;
    };

    const renderQuestion = () => {
      const question = questions[state.index];
      if (!question) return;

      state.optionIndex = -1;
      state.scaleValue = 0;
      scaleInputs.forEach(input => {
        input.checked = false;
      });

      const number = state.index + 1;
      counter.textContent = 'Pertanyaan ' + number + ' / ' + totalQuestions;
      typeTag.textContent =
        question.type === 'listening' ? 'Listening' : 'Reading';
      qIndex.textContent = 'Pertanyaan ' + String(number).padStart(2, '0');
      promptId.textContent = question.prompt.idText;
      promptJp.textContent = question.prompt.jpText;
      nextLabel.textContent =
        number === totalQuestions ? 'Lihat Hasil' : 'Lanjut';

      const ratio = state.index / totalQuestions;
      progressFill.style.width = ratio * 100 + '%';
      progressBar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));

      buildMedia(question);
      buildOptions(question);
      syncNextButton();
      announce(
        'Pertanyaan ' + number + ' dari ' + totalQuestions + ', ' +
          (question.type === 'listening' ? 'listening' : 'reading')
      );
    };

    // ========== STEP 2: SCALE ==========
    scaleInputs.forEach(input => {
      input.addEventListener('change', () => {
        state.scaleValue = Number(input.value) || 0;
        syncNextButton();
      });
    });

    // ========== RESULT CALCULATION (phase-1 placeholder formula) ==========
    // Note: this is a mock heuristic for the handoff flow. Phase 2 replaces it
    // with the weighted quiz-accuracy x comprehension-scale model.
    const summarizeType = type => {
      const items = state.answers.filter(answer => answer.type === type);
      if (items.length === 0) return null;
      const scores = items.map(item => {
        const quizShift = item.correct ? 0.5 : -0.75;
        const scaleShift = (item.scale - 5) * 0.2;
        return item.level + quizShift + scaleShift;
      });
      const mean = scores.reduce((sum, value) => sum + value, 0) / scores.length;
      return clampLevel(mean);
    };

    const levelNote = level => {
      const notes = {
        1: 'Konten level ini masih terasa seperti bunyi saja. Mulai dari input yang sangat mudah.',
        2: 'Kata-kata lepas mulai muncul. Perbanyak materi dengan visual pendukung.',
        3: 'Frasa pendek mulai masuk. Waktunya menambah jam menonton setiap hari.',
        4: 'Topik umum sudah bisa ditebak. Coba konten tanpa subtitle sama sekali.',
        5: 'Inti cerita dan emosi sudah tertangkap. Tingkatkan kesulitan materinya.',
        6: 'Alur cerita bisa diikuti. Tantang dirimu dengan konten native penuh.',
        7: 'Hampir semua hal dipahami. Fokus ke nuansa, dialek, dan kecepatan asli.',
      };
      return notes[level] || '';
    };

    const renderResult = () => {
      const listening = summarizeType('listening');
      const reading = summarizeType('reading');
      const correctCount = state.answers.filter(a => a.correct).length;
      const scaleMean =
        state.answers.reduce((sum, a) => sum + a.scale, 0) /
        (state.answers.length || 1);

      levelListening.textContent = listening === null ? '–' : String(listening);
      levelReading.textContent = reading === null ? '–' : String(reading);
      noteListening.textContent = listening === null ? '' : levelNote(listening);
      noteReading.textContent = reading === null ? '' : levelNote(reading);

      statCorrect.textContent = correctCount + ' / ' + state.answers.length;
      statScale.textContent = scaleMean.toFixed(1) + ' / 10';
      statSelf.textContent = 'Lv ' + state.selfLevel;

      const measured =
        listening === null || reading === null
          ? listening === null
            ? reading
            : listening
          : (listening + reading) / 2;
      const safeMeasured = measured === null ? state.selfLevel : measured;
      const diff = safeMeasured - state.selfLevel;

      let headline;
      if (diff >= 1) {
        headline =
          'Pemahaman medianya lebih tinggi dari perkiraanmu — kamu lebih jauh dari yang kamu sangka.';
      } else if (diff <= -1) {
        headline =
          'Kamu cenderung menaksir berlebih. Ini normal: kenali dulu batas nyatamu, lalu bangun dari sana.';
      } else {
        headline =
          'Penilaian dirimu sudah akurat. Kamu tahu persis di mana posisimu sekarang.';
      }
      gapHeadline.textContent = headline;

      const insights = [];
      if (listening !== null && reading !== null) {
        if (reading - listening >= 1) {
          insights.push(
            'Kekuatanmu ada di membaca. Menonton tanpa subtitle masih terasa berat — tambah porsi listening secara bertahap.'
          );
        } else if (listening - reading >= 1) {
          insights.push(
            'Kekuatanmu ada di mendengar. Menambah jam membaca akan mempercepat kosakata dan kanji-mu.'
          );
        } else {
          insights.push(
            'Kemampuan listening dan reading-mu seimbang. Ini tanda input yang sehat di kedua sisi.'
          );
        }
      }
      if (correctCount < state.answers.length) {
        insights.push(
          'Ada jawaban yang meleset. Itu bukan kegagalan — justru menandai bagian yang perlu didengar ulang.'
        );
      } else {
        insights.push(
          'Semua jawaban tepat. Naikkan level materi sedikit agar tetap ada tantangan.'
        );
      }
      if (scaleMean < 4) {
        insights.push(
          'Skala pemahamanmu rendah. Turunkan kesulitan materi dulu sampai kamu bisa menikmatinya tanpa jeda.'
        );
      } else if (scaleMean >= 7) {
        insights.push(
          'Skala pemahamanmu tinggi. Konten ini sudah nyaman — pindah ke materi yang lebih menantang.'
        );
      }

      gapList.textContent = '';
      insights.forEach(text => {
        const li = document.createElement('li');
        li.className = 'jct-gap-item';
        li.textContent = text;
        gapList.append(li);
      });

      resultLead.textContent =
        'Berdasarkan ' +
        state.answers.length +
        ' soal media asli dan penilaian dirimu (Lv ' +
        state.selfLevel +
        '), ini gambaran pemahamanmu saat ini.';

      announce('Hasil tes ditampilkan.');
    };

    // ========== FLOW ==========
    const goToTest = () => {
      state.index = 0;
      state.answers = [];
      showPanel('test');
      renderQuestion();
      focusPanel('test');
    };

    const advance = () => {
      const question = questions[state.index];
      if (!question) return;

      state.answers.push({
        id: question.id,
        type: question.type,
        level: question.level,
        correct: state.optionIndex === question.answer,
        scale: state.scaleValue,
      });

      if (state.index + 1 < totalQuestions) {
        state.index += 1;
        renderQuestion();
        return;
      }

      stopPlayer();
      progressFill.style.width = '100%';
      progressBar.setAttribute('aria-valuenow', '100');
      renderResult();
      showPanel('result');
      scrollToTop();
      focusPanel('result');
    };

    const resetAll = () => {
      stopPlayer();
      state.selfLevel = 0;
      state.index = 0;
      state.optionIndex = -1;
      state.scaleValue = 0;
      state.answers = [];
      selfLevelInputs.forEach(input => {
        input.checked = false;
      });
      scaleInputs.forEach(input => {
        input.checked = false;
      });
      progressFill.style.width = '0%';
      progressBar.setAttribute('aria-valuenow', '0');
      syncStartButton();
      showPanel('start');
      scrollToTop();
      focusPanel('start');
      announce('Tes diulang dari awal.');
    };

    // ========== WIRING ==========
    startBtn.addEventListener('click', goToTest);
    nextBtn.addEventListener('click', advance);
    retryBtn.addEventListener('click', resetAll);

    syncStartButton();
    syncNextButton();
    showPanel('start');
  })();
</script>
