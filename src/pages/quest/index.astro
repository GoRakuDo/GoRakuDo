---
// src/pages/quest/index.astro
// Prologue scene: fullscreen cave (gradient fallback until the WebP is placed),
// guide sprite slot, DialogueBox-driven scenario, finale overlay.
import UnifiedSEO from '../../components/common/UnifiedSEO.astro';
import DialogueBox from '../../components/quest/DialogueBox.astro';
import prologue from '../../data/quest/prologue.json';
import '../../styles/global.css';

const GUIDE_URL = '/panduan-immersion-belajar-bahasa-jepang-dengan-otodidak';

const seoData = {
  title: 'Prolog: Siswa di Dalam Cermin — GoRakuDo Quest',
  description:
    'Mulailah petualangan bahasa Jepangmu dari kelas bahasa Indonesia dan tinggalkan Metode Tradisional.',
  keywords: ['quest', 'prologue', 'immersion', 'belajar bahasa jepang', 'otodidak'],
  pageType: 'website' as const,
};

const speakerNames: Record<string, string> = Object.fromEntries(
  Object.entries(prologue.speakers).map(([key, value]) => [
    key,
    (value as { name: string }).name,
  ])
);

const dialogueLines = prologue.lines.map(line => ({
  id: line.id,
  speaker: line.speaker,
  name: speakerNames[line.speaker] ?? 'AI Kasou Yoshia',
  text: line.idText,
  // VN staging flag: 'sharp' (default) or 'blur'. Omitted => 'sharp'.
  bg: (line as { bg?: string }).bg ?? 'sharp',
  // Branching: choices jump via nextLine, action navigates away.
  // Omitted => linear advance to the next array entry.
  nextLine: (line as { nextLine?: string }).nextLine ?? null,
  position: (line as { position?: string }).position ?? null,
  audio: (line as { audio?: string }).audio ?? null,
  choices: ((line as { choices?: Array<{ id: string; idText: string; jpText: string; nextLine: string }> }).choices ?? []).map(c => ({
    id: c.id,
    idText: c.idText,
    jpText: c.jpText,
    nextLine: c.nextLine,
  })),
  action: (line as { action?: { type: string; idText: string; jpText: string; target?: string } | null }).action ?? null,
}));

// Line IDs that own a guide expression image at /images/quest/guide-<id>.webp.
// p01 has none by direction (empty stage on the 1st line); p06 is the
// player's inner voice and keeps the previous expression.
const expressionIds = [
  'p02',
  'p03_return',
  'p03_yes',
  'p03_yes_desc',
  'p03_no_exit',
  'p04',
  'p05',
  'p07',
];

const bgSrc = prologue.scene.background;
const bgBlurSrc = (prologue.scene as { backgroundBlur?: string }).backgroundBlur;
const firstLine = dialogueLines[0] ?? { name: 'AI Kasou Yoshia', text: '' };
---

<html lang='id' class='quest-page'>
  <head>
    <UnifiedSEO
      title={seoData.title}
      description={seoData.description}
      keywords={seoData.keywords}
      pageType={seoData.pageType}
      lang='id'
      gtag={import.meta.env.PUBLIC_GA_ID}
    />
    <style>
      html.quest-page,
      html.quest-page body {
        overflow: hidden;
        height: 100%;
        padding-bottom: 0;
      }

      .quest-finale[hidden] {
        display: none;
      }

      .quest-chapters[hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <main class='quest-scene' aria-label='Prolog quest: Siswa di Dalam Cermin'>
      <div class='quest-scene-bg-fallback' aria-hidden='true'></div>
      <img
        class='quest-scene-bg-image'
        src={bgSrc}
        alt=''
        aria-hidden='true'
        loading='eager'
        decoding='async'
        onload="this.classList.add('is-loaded')"
        onerror='this.remove()'
      />
      {bgBlurSrc && (
        <img
          class='quest-scene-bg-blur'
          data-quest-bg-blur
          src={bgBlurSrc}
          alt=''
          aria-hidden='true'
          loading='eager'
          decoding='async'
          onload="this.classList.add('is-loaded')"
          onerror='this.remove()'
        />
      )}
      <div class='quest-scene-veil' aria-hidden='true'></div>

      <p class='quest-chapter'><span lang='ja'>序章</span> — {prologue.title}</p>
      <div class='quest-top-actions'>
        <button
          class='quest-mute'
          data-quest-bgm-mute
          type='button'
          aria-pressed='false'
          aria-label='Matikan musik latar'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='quest-mute-icon lucide lucide-audio-lines'
            data-quest-bgm-icon-on
            aria-hidden='true'
          >
            <path d='M2 10v3'></path>
            <path d='M6 6v11'></path>
            <path d='M10 3v18'></path>
            <path d='M14 8v7'></path>
            <path d='M18 5v13'></path>
            <path d='M22 10v3'></path>
          </svg>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='quest-mute-icon lucide lucide-audio-lines-off'
            data-quest-bgm-icon-off
            aria-hidden='true'
            hidden
          >
            <path d='M10 10v11'></path>
            <path d='M10 3v1.35'></path>
            <path d='M14 14v1'></path>
            <path d='M14 8v.35'></path>
            <path d='M18 5v7.35'></path>
            <path d='M2 10v3'></path>
            <path d='m2 2 20 20'></path>
            <path d='M22 10v3'></path>
            <path d='M6 6v11'></path>
          </svg>
        </button>
      </div>

      <div class='quest-guide is-hidden' data-quest-guide>
        <img
          src='/images/quest/guide.webp'
          alt=''
          aria-hidden='true'
          loading='lazy'
          decoding='async'
          onerror="if(!this.dataset.fbk){this.dataset.fbk='1';this.src='/images/quest/guide.webp';}"
        />
      </div>

      <div class='quest-dialogue-zone'>
        <div class='quest-choices' data-quest-choices hidden></div>
        <DialogueBox
          typingSpeedMs={30}
          initialName={firstLine.name}
          initialText={firstLine.text}
        />
      </div>

      <div
        class='quest-chapters'
        data-quest-chapters
        hidden
        inert
        role='dialog'
        aria-modal='true'
        aria-label='Pilih Chapter'
      >
        <div class='quest-chapters-inner'>
          <p class='quest-chapters-kicker'>/// QUEST SELECT ///</p>
          <h1 class='quest-chapters-title'>Pilih Chapter</h1>
          <div class='quest-chapters-list'>
            <button
              type='button'
              class='quest-chapter-item is-active'
              data-quest-start-prologue
            >
              <span class='quest-chapter-badge'>PROLOG</span>
              <span class='quest-chapter-name'>{prologue.title}</span>
              <span class='quest-chapter-cta'>Mulai ▶</span>
            </button>
            <div class='quest-chapter-item is-locked' aria-disabled='true'>
              <span class='quest-chapter-badge'>CHAPTER I</span>
              <span class='quest-chapter-name'>Metode Tradisional</span>
              <span class='quest-chapter-status'>Segera Hadir</span>
            </div>
            <div class='quest-chapter-item is-locked' aria-disabled='true'>
              <span class='quest-chapter-badge'>CHAPTER II</span>
              <span class='quest-chapter-name'>Jalan Alami Immersion</span>
              <span class='quest-chapter-status'>Segera Hadir</span>
            </div>
          </div>
        </div>
      </div>
      <div
        class='quest-finale'
        data-quest-finale
        hidden
        inert
        role='dialog'
        aria-modal='true'
        aria-label='Prolog selesai'
      >
        <div class='quest-finale-inner'>
          <p class='quest-finale-title'>To be continued…</p>
          <p class='quest-finale-text'>
            Prolog selesai! Bab berikutnya masih ditulis. Sambil menunggu,
            baca panduan immersion dan mulai petualanganmu sekarang.
          </p>
          <a class='quest-finale-cta' href={GUIDE_URL}>
            Lanjut ke Panduan Immersion
          </a>
        </div>
      </div>
    </main>

    <script
      is:inline
      define:vars={{ dialogueLines, expressionIds }}
    >
      (() => {
        const dialogue = document.querySelector('[data-quest-dialogue]');
        const guide = document.querySelector('[data-quest-guide]');
        const guideImg = guide ? guide.querySelector('img') : null;
        const choiceBox = document.querySelector('[data-quest-choices]');
        const finale = document.querySelector('[data-quest-finale]');
        const chapters = document.querySelector('[data-quest-chapters]');
        const startPrologueBtn = document.querySelector(
          '[data-quest-start-prologue]'
        );
        if (!dialogue || !finale || !choiceBox) return;

        // --- Voice playback: one <audio> element, swapped per line. ---
        // Lines without `audio` (none today, possible later) do nothing.
        // Voice is always unmuted. A blocked first-line autoplay falls back
        // to the Chapter List overlay (see playVoice).
        const DIRECT_FLAG = 'grkd:quest-direct-prologue';
        // Detached (never appended): no UI, still plays programmatically.
        // Exposed for tests as window.__questVoice.
        const voice = document.createElement('audio');
        voice.preload = 'auto';
        voice.setAttribute('data-quest-voice', '');
        window.__questVoice = voice;
        // --- Background music: one looping <audio>, on by default. ---
        // Mute persists in localStorage; while muted the track stays
        // paused instead of playing silently, so it costs nothing and
        // starts the moment it is switched back on during the lines.
        // Volume sits well below the line voice so dialogue stays clear.
        const BGM_MUTE_FLAG = 'grkd:quest-bgm-muted';
        const BGM_SRC = '/assets/bgm/quest/prologue.mp3';
        // Detached (never appended): no UI, still plays programmatically.
        // Exposed for tests as window.__questBgm.
        const bgm = document.createElement('audio');
        bgm.src = BGM_SRC;
        bgm.loop = true;
        bgm.preload = 'auto';
        bgm.volume = 0.22;
        bgm.setAttribute('data-quest-bgm', '');
        window.__questBgm = bgm;
        const bgmMuteBtn = document.querySelector('[data-quest-bgm-mute]');
        const bgmIconOn = bgmMuteBtn
          ? bgmMuteBtn.querySelector('[data-quest-bgm-icon-on]')
          : null;
        const bgmIconOff = bgmMuteBtn
          ? bgmMuteBtn.querySelector('[data-quest-bgm-icon-off]')
          : null;

        const applyBgmMuteUI = () => {
          const muted = bgm.muted;
          if (bgmMuteBtn) {
            bgmMuteBtn.setAttribute('aria-pressed', String(muted));
            bgmMuteBtn.setAttribute(
              'aria-label',
              muted ? 'Nyalakan musik latar' : 'Matikan musik latar'
            );
          }
          if (bgmIconOn) bgmIconOn.toggleAttribute('hidden', muted);
          if (bgmIconOff) bgmIconOff.toggleAttribute('hidden', !muted);
        };

        const playBgm = () => {
          if (bgm.muted) return;
          const pending = bgm.play();
          if (pending && typeof pending.catch === 'function') {
            pending.catch(() => {
              // Autoplay blocked or the track failed to load: the
              // Chapter List keeps working, BGM just stays silent.
            });
          }
        };

        const pauseBgm = () => {
          try {
            bgm.pause();
          } catch {
            // pause() on a fresh element is a no-op in practice.
          }
        };

        try {
          bgm.muted = window.localStorage.getItem(BGM_MUTE_FLAG) === 'true';
        } catch {
          // Storage unavailable => default to unmuted.
        }
        applyBgmMuteUI();

        if (bgmMuteBtn) {
          bgmMuteBtn.addEventListener('click', () => {
            bgm.muted = !bgm.muted;
            try {
              window.localStorage.setItem(BGM_MUTE_FLAG, String(bgm.muted));
            } catch {
              // Storage unavailable: mute applies to this visit only.
            }
            if (bgm.muted) {
              pauseBgm();
            } else if (phase !== 'chapters') {
              playBgm();
            }
            applyBgmMuteUI();
          });
        }

        const playVoice = (line) => {
          if (!line || !line.audio) return;
          // Stop the previous line's audio before swapping.
          try {
            voice.pause();
          } catch {
            // pause() on a fresh element is a no-op in practice.
          }
          if (voice.getAttribute('src') !== line.audio) {
            voice.setAttribute('src', line.audio);
          }
          try {
            voice.currentTime = 0;
          } catch {
            // Not yet seekable => play from wherever it loads.
          }
          const pending = voice.play();
          if (pending && typeof pending.catch === 'function') {
            pending.catch((err) => {
              // Browser permission rejection on the very first line =>
              // fall back to the Chapter List so the typewriter never
              // advances silently. Network/decoding errors are ignored.
              if (
                (!err || err.name === 'NotAllowedError') &&
                currentId === startId &&
                phase === 'lines'
              ) {
                openChapters();
              }
            });
          }
        };

        const api = () => window.__questDialogue;
        const lineById = new Map(dialogueLines.map((l) => [l.id, l]));
        const expressions = new Set(expressionIds);

        // Returnees resume at p03_return; the flag is consumed in
        // startPrologue() so the next visit starts at p01 again.
        const RETURN_FLAG = 'grkd:quest-left-via-no';

        // Navigation state is line-ID based (not an array index) so
        // nextLine jumps resolve correctly (p03_return => p03_yes,
        // never back to p02). history supports future back navigation.
        // Returnees resume at p03_return; the seeded entry keeps the p01
        // empty-stage direction (guide visible from the 2nd line on).
        let startId = dialogueLines[0] ? dialogueLines[0].id : null;
        try {
          if (
            window.localStorage.getItem(RETURN_FLAG) === '1' &&
            lineById.has('p03_return')
          ) {
            startId = 'p03_return';
          }
        } catch {
          // Storage unavailable (private mode etc.) => start at p01.
        }
        let currentId = startId;
        const history = currentId ? [currentId] : [];
        if (currentId === 'p03_return') {
          const firstId = dialogueLines[0] ? dialogueLines[0].id : null;
          if (firstId && firstId !== currentId) history.unshift(firstId);
        }

        // Hero CTA sets DIRECT_FLAG in sessionStorage before navigating
        // here; direct visits and F5 reloads have no flag and land on the
        // Chapter List instead. The flag is consumed on read (one-shot).
        let fromHero = false;
        try {
          const navEntries =
            typeof performance !== 'undefined' && performance.getEntriesByType
              ? performance.getEntriesByType('navigation')
              : [];
          const isReload = navEntries[0] && navEntries[0].type === 'reload';
          if (window.sessionStorage.getItem(DIRECT_FLAG) === '1') {
            window.sessionStorage.removeItem(DIRECT_FLAG);
            if (!isReload) fromHero = true;
          }
        } catch {
          // Storage unavailable => treat as direct access.
        }

        // Preload only the first needed sprite (fresh visit: p02, returnee:
        // p03_return) so the swap doesn't flicker. A missing file fails
        // silently here; the onerror fallback covers display time.
        // (Preloading every expression upfront cost ~1MB+.)
        const preloadId =
          currentId === 'p03_return' ? 'p03_return' : 'p02';
        if (expressions.has(preloadId)) {
          const pre = new Image();
          pre.src = `/images/quest/guide-${preloadId}.webp`;
        }
        let phase = 'lines';
        // True while choice/action buttons for the current line await input.
        let awaitingInput = false;

        const speaking = (on) => {
          if (guide) guide.classList.toggle('is-speaking', on);
        };

        const scene = document.querySelector('.quest-scene');

        // Swap the guide sprite when the line owns an expression image.
        // Lines without one (p01 by direction, p06 player voice) keep
        // the previous sprite; a broken file falls back to guide.webp
        // without removing the guide frame. dataset.fbk is reset per swap
        // so the onerror fallback works for every line, not just once.
        const applyExpression = (lineId) => {
          if (!guideImg || !expressions.has(lineId)) return;
          const next = `/images/quest/guide-${lineId}.webp`;
          if (guideImg.getAttribute('src') !== next) {
            delete guideImg.dataset.fbk;
            guideImg.src = next;
          }
        };

        // VN staging: background crossfade follows the line's `bg` flag
        // ('blur' => blurred layer on), guide appears from the 2nd line
        // on (history position >= 1, i.e. the p01 empty-stage direction).
        // Re-trigger the 0.7s digital glitch animation whenever the guide speaks
        // (both on initial apparition and on subsequent line/expression changes).
        const triggerGlitch = () => {
          if (!guide || guide.classList.contains('is-hidden')) return;
          guide.classList.remove('is-glitching');
          void guide.offsetWidth;
          guide.classList.add('is-glitching');
        };

        if (guide) {
          guide.addEventListener('animationend', (e) => {
            if (e.animationName === 'questGlitchIn') {
              guide.classList.remove('is-glitching');
            }
          });
        }

        const applyStage = (line, pos) => {
          const blurred = !!line && line.bg === 'blur';
          if (scene) scene.classList.toggle('is-blurred', blurred);
          if (guide) {
            guide.classList.toggle('is-hidden', pos < 1);
            if (line && line.position) {
              guide.dataset.position = line.position;
            } else if (line && line.text) {
              guide.dataset.position = 'right';
            }
          }
        };

        const clearChoices = () => {
          awaitingInput = false;
          choiceBox.hidden = true;
          choiceBox.textContent = '';
        };

        const focusFirstChoice = () => {
          const btn = choiceBox.querySelector('button, a');
          if (btn) btn.focus({ preventScroll: true });
        };

        const makeButton = (idText, jpText) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'quest-choice';
          const primary = document.createElement('span');
          primary.className = 'quest-choice-id';
          primary.textContent = idText;
          const sub = document.createElement('span');
          sub.className = 'quest-choice-jp';
          sub.textContent = jpText;
          sub.lang = 'ja';
          btn.append(primary, sub);
          return btn;
        };

        // Rendered on typing completion: choice buttons jump via nextLine,
        // the exit action links home (flagging the returnee resume), and
        // the p07 action opens the finale overlay directly.
        const renderPending = (line) => {
          clearChoices();
          if (!line) return;
          if (line.choices && line.choices.length > 0) {
            awaitingInput = true;
            line.choices.forEach((c) => {
              const btn = makeButton(c.idText, c.jpText);
              btn.addEventListener('click', () => goTo(c.nextLine));
              choiceBox.append(btn);
            });
            choiceBox.hidden = false;
            focusFirstChoice();
          } else if (line.action) {
            awaitingInput = true;
            if (line.action.type === 'open_finale') {
              const btn = makeButton(line.action.idText, line.action.jpText);
              btn.addEventListener('click', () => {
                // Drop the button first so it can't stay focusable
                // behind the modal overlay, then open it.
                clearChoices();
                openFinale();
              });
              choiceBox.append(btn);
            } else {
              const link = document.createElement('a');
              link.className = 'quest-choice';
              link.href = line.action.target || '/';
              const primary = document.createElement('span');
              primary.className = 'quest-choice-id';
              primary.textContent = line.action.idText;
              const sub = document.createElement('span');
              sub.className = 'quest-choice-jp';
              sub.textContent = line.action.jpText;
              sub.lang = 'ja';
              link.append(primary, sub);
              if (line.action.type === 'exit_to_home') {
                // Flag the returnee resume before leaving for /.
                link.addEventListener('click', () => {
                  try {
                    window.localStorage.setItem(RETURN_FLAG, '1');
                  } catch {
                    // Storage unavailable: resume just starts at p01.
                  }
                });
              }
              choiceBox.append(link);
            }
            choiceBox.hidden = false;
            focusFirstChoice();
          }
        };

        const showId = (lineId) => {
          const line = lineById.get(lineId);
          if (!line) return;
          currentId = lineId;
          clearChoices();
          applyStage(line, history.length - 1);
          applyExpression(lineId);
          playVoice(line);
          if (line.text) triggerGlitch();
          // Textless rows (p06 inner voice) keep the previous dialogue
          // box: skip showLine, then render the choice button directly
          // (no quest:line-complete will fire without a typing run).
          if (!line.text) {
            renderPending(line);
            return;
          }
          if (api()) api().showLine(line);
        };

        const advanceLinear = () => {
          const line = lineById.get(currentId);
          if (!line) return;
          // Explicit nextLine wins (p03_return => p03_yes); otherwise
          // fall through to the next array entry.
          if (line.nextLine && lineById.has(line.nextLine)) {
            goTo(line.nextLine);
            return;
          }
          const idx = dialogueLines.findIndex((l) => l.id === currentId);
          if (idx >= 0 && idx < dialogueLines.length - 1) {
            goTo(dialogueLines[idx + 1].id);
          } else {
            openFinale();
          }
        };

        const goTo = (lineId) => {
          if (!lineId || !lineById.has(lineId)) return;
          history.push(lineId);
          showId(lineId);
          // The tapped button is removed by showId => clearChoices, so
          // focus would fall to <body>; keep it on the dialogue.
          // A textless row renders its choice synchronously, which already
          // focuses the first button — don't steal it back (p06).
          if (!awaitingInput) dialogue.focus({ preventScroll: true });
        };

        // Keep background controls out of the tab order / AT tree while the
        // finale overlay is open (same inert-based approach as
        // image-zoom.js). Listed explicitly: BGM mute button, dialogue box,
        // and choices.
        const setBackgroundInert = (on) => {
          document
            .querySelectorAll(
              '[data-quest-bgm-mute], [data-quest-dialogue], [data-quest-choices]'
            )
            .forEach((el) => {
              if (on) el.setAttribute('inert', '');
              else el.removeAttribute('inert');
            });
        };

        const openFinale = () => {
          if (phase === 'finale') return;
          phase = 'finale';
          finale.hidden = false;
          finale.removeAttribute('inert');
          setBackgroundInert(true);
          const cta = finale.querySelector('a');
          if (cta) cta.focus();
        };

        // Chapter List overlay: direct visits (and F5 reloads) land here;
        // the homepage hero CTA jumps straight into the prologue instead.
        function openChapters() {
          if (!chapters) return;
          phase = 'chapters';
          chapters.hidden = false;
          chapters.removeAttribute('inert');
          setBackgroundInert(true);
          // Leaving the lines (direct visit, reload, or the fallback when
          // the first-line voice autoplay is blocked) must not leave the
          // BGM running behind the overlay.
          pauseBgm();
          // Preload the first line's voice without playing it.
          const first = lineById.get(currentId);
          if (
            first &&
            first.audio &&
            voice.getAttribute('src') !== first.audio
          ) {
            voice.setAttribute('src', first.audio);
            voice.load();
          }
          if (startPrologueBtn) startPrologueBtn.focus({ preventScroll: true });
        }

        function startPrologue() {
          // Deferred consumption: closing the tab after only seeing the
          // Chapter List keeps the return flag for the next visit.
          try { window.localStorage.removeItem(RETURN_FLAG); } catch {}
          if (chapters) {
            chapters.hidden = true;
            chapters.setAttribute('inert', '');
          }
          setBackgroundInert(false);
          phase = 'lines';
          showId(currentId);
          playBgm();
          if (!awaitingInput) dialogue.focus({ preventScroll: true });
        }

        if (startPrologueBtn) {
          startPrologueBtn.addEventListener('click', () => startPrologue());
        }

        dialogue.addEventListener('quest:line-start', () => speaking(true));
        dialogue.addEventListener('quest:line-complete', () => {
          speaking(false);
          // Typing done => offer this line's choices/action, if any.
          if (phase === 'lines') renderPending(lineById.get(currentId));
        });

        dialogue.addEventListener('quest:dialogue-activate', (e) => {
          if (phase !== 'lines' || !api()) return;
          if (!e.detail || !e.detail.complete) {
            api().finish();
            return;
          }
          // Choice/action input pending => the advance tap/click only
          // moves focus to the buttons; the route is chosen by tapping one.
          if (awaitingInput) {
            focusFirstChoice();
            return;
          }
          advanceLinear();
        });

        if (fromHero) {
          if (api()) {
            startPrologue();
          } else {
            document.addEventListener('DOMContentLoaded', () => startPrologue());
          }
        } else if (api()) {
          openChapters();
        } else {
          document.addEventListener('DOMContentLoaded', () => openChapters());
        }
      })();
    </script>
  </body>
</html>
