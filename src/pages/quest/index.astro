---
// src/pages/quest/index.astro
// Prologue scene: fullscreen cave (gradient fallback until the WebP is placed),
// guide sprite slot, DialogueBox-driven scenario, commandments + finale overlays.
import UnifiedSEO from '../../components/common/UnifiedSEO.astro';
import DialogueBox from '../../components/quest/DialogueBox.astro';
import prologue from '../../data/quest/prologue.json';
import '../../styles/global.css';

const GUIDE_URL = '/panduan-immersion-belajar-bahasa-jepang-dengan-otodidak';

const seoData = {
  title: 'Prolog: Siswa di Dalam Cermin — GoRakuDo Quest',
  description:
    'Mulailah petualangan bahasa Jepangmu dari kelas bahasa Indonesia. Ikuti 4 hukum suci immersion dan tinggalkan Metode Tradisional.',
  keywords: ['quest', 'prologue', 'immersion', 'belajar bahasa jepang', 'otodidak'],
  pageType: 'website' as const,
};

const speakerNames: Record<string, string> = Object.fromEntries(
  Object.entries(prologue.speakers).map(([key, value]) => [
    key,
    (value as { name: string }).name,
  ])
);

const dialogueLines = prologue.lines.map(line => ({
  id: line.id,
  speaker: line.speaker,
  name: speakerNames[line.speaker] ?? 'AI Kasou Yoshia',
  text: line.idText,
  // VN staging flag: 'sharp' (default) or 'blur'. Omitted => 'sharp'.
  bg: (line as { bg?: string }).bg ?? 'sharp',
  // Branching: choices jump via nextLine, action navigates away.
  // Omitted => linear advance to the next array entry.
  nextLine: (line as { nextLine?: string }).nextLine ?? null,
  choices: ((line as { choices?: Array<{ id: string; idText: string; jpText: string; nextLine: string }> }).choices ?? []).map(c => ({
    id: c.id,
    idText: c.idText,
    jpText: c.jpText,
    nextLine: c.nextLine,
  })),
  action: (line as { action?: { type: string; idText: string; jpText: string; target: string } | null }).action ?? null,
}));

// Line IDs that own a guide expression image at /images/quest/guide-<id>.webp.
// p01 has none by direction (empty stage on the 1st line); p06 is the
// player's inner voice and keeps the previous expression.
const expressionIds = [
  'p02',
  'p01_return',
  'p03_yes',
  'p03_yes_desc',
  'p03_no_exit',
  'p04',
  'p05',
  'p07',
];

const commandmentItems = ((prologue as { commandments?: Array<{ idText: string }> }).commandments ?? []).map(item => item.idText);
const bgSrc = prologue.scene.background;
const bgBlurSrc = (prologue.scene as { backgroundBlur?: string }).backgroundBlur;
const firstLine = dialogueLines[0] ?? { name: 'AI Kasou Yoshia', text: '' };
---

<html lang='id' class='quest-page'>
  <head>
    <UnifiedSEO
      title={seoData.title}
      description={seoData.description}
      keywords={seoData.keywords}
      pageType={seoData.pageType}
      lang='id'
      gtag={import.meta.env.PUBLIC_GA_ID}
    />
    <style>
      html.quest-page,
      html.quest-page body {
        overflow: hidden;
        height: 100%;
      }

      .quest-commandments[hidden],
      .quest-finale[hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <main class='quest-scene' aria-label='Prolog quest: Siswa di Dalam Cermin'>
      <div class='quest-scene-bg-fallback' aria-hidden='true'></div>
      <img
        class='quest-scene-bg-image'
        src={bgSrc}
        alt=''
        aria-hidden='true'
        loading='eager'
        decoding='async'
        onload="this.classList.add('is-loaded')"
        onerror='this.remove()'
      />
      {bgBlurSrc && (
        <img
          class='quest-scene-bg-blur'
          data-quest-bg-blur
          src={bgBlurSrc}
          alt=''
          aria-hidden='true'
          loading='eager'
          decoding='async'
          onload="this.classList.add('is-loaded')"
          onerror='this.remove()'
        />
      )}
      <div class='quest-scene-veil' aria-hidden='true'></div>

      <p class='quest-chapter'><span lang='ja'>序章</span> — {prologue.title}</p>
      <a
        class='quest-skip'
        data-quest-skip
        href={GUIDE_URL}
        aria-label='Lewati prolog dan buka panduan immersion'
      >
        SKIP →
      </a>

      <div class='quest-guide is-hidden' data-quest-guide>
        <img
          src='/images/quest/guide.webp'
          alt=''
          aria-hidden='true'
          loading='lazy'
          decoding='async'
          onerror="if(!this.dataset.fbk){this.dataset.fbk='1';this.src='/images/quest/guide.webp';}"
        />
      </div>

      <div class='quest-dialogue-zone'>
        <DialogueBox
          typingSpeedMs={30}
          initialName={firstLine.name}
          initialText={firstLine.text}
        />
        <div class='quest-choices' data-quest-choices hidden></div>
      </div>

      <div
        class='quest-commandments'
        data-quest-commandments
        hidden
        inert
        role='dialog'
        aria-modal='true'
        aria-label='4 hukum suci immersion'
      >
        <div class='quest-commandments-card'>
          <h2 class='quest-commandments-title'>✦ 4 HUKUM SUCI ✦</h2>
          <ul class='quest-commandments-list'>
            {
              commandmentItems.map((item, i) => (
                <li
                  class='quest-commandments-item'
                  style={`--quest-delay: ${(i * 0.35).toFixed(2)}s`}
                >
                  {item}
                </li>
              ))
            }
          </ul>
          <button
            class='quest-commandments-close'
            type='button'
            data-quest-commandments-close
          >
            Aku bersumpah!
          </button>
        </div>
      </div>

      <div
        class='quest-finale'
        data-quest-finale
        hidden
        inert
        role='dialog'
        aria-modal='true'
        aria-label='Prolog selesai'
      >
        <div class='quest-finale-inner'>
          <p class='quest-finale-title'>To be continued…</p>
          <p class='quest-finale-text'>
            Prolog selesai! Bab berikutnya masih ditulis. Sambil menunggu,
            baca panduan immersion dan mulai petualanganmu sekarang.
          </p>
          <a class='quest-finale-cta' href={GUIDE_URL}>
            Lanjut ke Panduan Immersion
          </a>
        </div>
      </div>
    </main>

    <script
      is:inline
      define:vars={{ dialogueLines, expressionIds }}
    >
      (() => {
        const dialogue = document.querySelector('[data-quest-dialogue]');
        const guide = document.querySelector('[data-quest-guide]');
        const guideImg = guide ? guide.querySelector('img') : null;
        const choiceBox = document.querySelector('[data-quest-choices]');
        const commandments = document.querySelector(
          '[data-quest-commandments]'
        );
        const commandmentsClose = document.querySelector(
          '[data-quest-commandments-close]'
        );
        const finale = document.querySelector('[data-quest-finale]');
        if (!dialogue || !commandments || !finale || !choiceBox) return;

        const api = () => window.__questDialogue;
        const lineById = new Map(dialogueLines.map((l) => [l.id, l]));
        const expressions = new Set(expressionIds);

        // Preload expression sprites so the swap doesn't flicker
        // (each ~140-190KB). Missing files simply fail silently here;
        // the onerror fallback on the live <img> covers display time.
        expressions.forEach((id) => {
          const pre = new Image();
          pre.src = `/images/quest/guide-${id}.webp`;
        });

        // Navigation state is line-ID based (not an array index) so
        // nextLine jumps resolve correctly (p01_return => p03_yes,
        // never back to p02). history supports future back navigation.
        let currentId = dialogueLines[0] ? dialogueLines[0].id : null;
        const history = currentId ? [currentId] : [];
        let phase = 'lines';
        // True while choice/action buttons for the current line await input.
        let awaitingInput = false;

        const speaking = (on) => {
          if (guide) guide.classList.toggle('is-speaking', on);
        };

        const scene = document.querySelector('.quest-scene');

        // Swap the guide sprite when the line owns an expression image.
        // Lines without one (p01 by direction, p06 player voice) keep
        // the previous sprite; a broken file falls back to guide.webp
        // without removing the guide frame.
        const applyExpression = (lineId) => {
          if (!guideImg || !expressions.has(lineId)) return;
          const next = `/images/quest/guide-${lineId}.webp`;
          if (guideImg.getAttribute('src') !== next) guideImg.src = next;
        };

        // VN staging: background crossfade follows the line's `bg` flag
        // ('blur' => blurred layer on), guide appears from the 2nd line
        // on (history position >= 1, i.e. the p01 empty-stage direction).
        const applyStage = (line, pos) => {
          const blurred = !!line && line.bg === 'blur';
          if (scene) scene.classList.toggle('is-blurred', blurred);
          if (guide) guide.classList.toggle('is-hidden', pos < 1);
        };

        const clearChoices = () => {
          awaitingInput = false;
          choiceBox.hidden = true;
          choiceBox.textContent = '';
        };

        const focusFirstChoice = () => {
          const btn = choiceBox.querySelector('button, a');
          if (btn) btn.focus({ preventScroll: true });
        };

        const makeButton = (idText, jpText) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'quest-choice';
          const primary = document.createElement('span');
          primary.className = 'quest-choice-id';
          primary.textContent = idText;
          const sub = document.createElement('span');
          sub.className = 'quest-choice-jp';
          sub.textContent = jpText;
          sub.lang = 'ja';
          btn.append(primary, sub);
          return btn;
        };

        // Rendered on typing completion: choice buttons jump via nextLine,
        // action buttons navigate away (exit_to_home => /, chapter_advance
        // => /quest/chapter-1, linked as-is even if the target 404s).
        const renderPending = (line) => {
          clearChoices();
          if (!line) return;
          if (line.choices && line.choices.length > 0) {
            awaitingInput = true;
            line.choices.forEach((c) => {
              const btn = makeButton(c.idText, c.jpText);
              btn.addEventListener('click', () => goTo(c.nextLine));
              choiceBox.append(btn);
            });
            choiceBox.hidden = false;
            focusFirstChoice();
          } else if (line.action) {
            awaitingInput = true;
            const link = document.createElement('a');
            link.className = 'quest-choice';
            link.href = line.action.target;
            const primary = document.createElement('span');
            primary.className = 'quest-choice-id';
            primary.textContent = line.action.idText;
            const sub = document.createElement('span');
            sub.className = 'quest-choice-jp';
            sub.textContent = line.action.jpText;
            sub.lang = 'ja';
            link.append(primary, sub);
            choiceBox.append(link);
            choiceBox.hidden = false;
            focusFirstChoice();
          }
        };

        const showId = (lineId) => {
          const line = lineById.get(lineId);
          if (!line) return;
          currentId = lineId;
          clearChoices();
          applyStage(line, history.length - 1);
          applyExpression(lineId);
          if (api()) api().showLine(line);
        };

        const advanceLinear = () => {
          const line = lineById.get(currentId);
          if (!line) return;
          // Explicit nextLine wins (p01_return => p03_yes); otherwise
          // fall through to the next array entry.
          if (line.nextLine && lineById.has(line.nextLine)) {
            goTo(line.nextLine);
            return;
          }
          const idx = dialogueLines.findIndex((l) => l.id === currentId);
          if (idx >= 0 && idx < dialogueLines.length - 1) {
            goTo(dialogueLines[idx + 1].id);
          } else {
            openCommandments();
          }
        };

        const goTo = (lineId) => {
          if (!lineId || !lineById.has(lineId)) return;
          history.push(lineId);
          showId(lineId);
        };

        // Keep background controls out of the tab order / AT tree while a
        // modal overlay is open (same inert-based approach as image-zoom.js).
        // Selector-based so future focusables are covered without code change.
        const setBackgroundInert = (on) => {
          document
            .querySelectorAll('[data-quest-skip], [data-quest-dialogue]')
            .forEach((el) => {
              if (on) el.setAttribute('inert', '');
              else el.removeAttribute('inert');
            });
        };

        const openCommandments = () => {
          phase = 'commandments';
          speaking(false);
          commandments.hidden = false;
          commandments.removeAttribute('inert');
          commandments.classList.add('is-open');
          setBackgroundInert(true);
          if (commandmentsClose) commandmentsClose.focus();
        };

        const closeCommandments = () => {
          if (phase !== 'commandments') return;
          phase = 'lines';
          commandments.hidden = true;
          commandments.classList.remove('is-open');
          commandments.setAttribute('inert', '');
          setBackgroundInert(false);
          dialogue.focus({ preventScroll: true });
        };

        const openFinale = () => {
          if (phase === 'finale') return;
          phase = 'finale';
          commandments.hidden = true;
          commandments.setAttribute('inert', '');
          finale.hidden = false;
          finale.removeAttribute('inert');
          setBackgroundInert(true);
          const cta = finale.querySelector('a');
          if (cta) cta.focus();
        };

        dialogue.addEventListener('quest:line-start', () => speaking(true));
        dialogue.addEventListener('quest:line-complete', () => {
          speaking(false);
          // Typing done => offer this line's choices/action, if any.
          if (phase === 'lines') renderPending(lineById.get(currentId));
        });

        dialogue.addEventListener('quest:dialogue-activate', (e) => {
          if (phase !== 'lines' || !api()) return;
          if (!e.detail || !e.detail.complete) {
            api().finish();
            return;
          }
          // Choice/action input pending => the advance tap/click only
          // moves focus to the buttons; the route is chosen by tapping one.
          if (awaitingInput) {
            focusFirstChoice();
            return;
          }
          advanceLinear();
        });

        if (commandmentsClose) {
          commandmentsClose.addEventListener('click', openFinale);
        }

        document.addEventListener('keydown', (e) => {
          if (e.repeat) return;
          // Escape only closes the commandments overlay. The finale is a
          // terminal screen by design (no going back), so Escape does
          // nothing there.
          if (e.key === 'Escape') {
            closeCommandments();
            return;
          }
          if (e.key !== 'Enter' && e.key !== ' ') return;
          const tag = (e.target.tagName || '').toLowerCase();
          if (tag === 'a' || tag === 'button') return;
          if (phase === 'commandments') {
            e.preventDefault();
            openFinale();
          }
        });

        if (api()) {
          showId(currentId);
        } else {
          document.addEventListener('DOMContentLoaded', () => showId(currentId));
        }
        dialogue.focus({ preventScroll: true });
      })();
    </script>
  </body>
</html>
