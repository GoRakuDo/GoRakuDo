---
import '../../../styles/components/bottom-navbar.css';

export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// Navigation items with icons and labels
const navItems = [
  {
    href: '/panduan-immersion-belajar-bahasa-jepang-dengan-otodidak',
    label: 'Panduan',
    icon: 'panduan',
    ariaLabel: 'Panduan - 学習ガイド',
  },
  {
    href: '/tutorial',
    label: 'Tutorial',
    icon: 'tutorial',
    ariaLabel: 'Tutorial - 学習ガイド',
  },
  {
    href: '#',
    label: 'Menu',
    icon: 'menu',
    ariaLabel: 'Menu - メニュー',
    isMenuButton: true,
  },
];

// Menu overlay items
const menuItems = [
  {
    href: '/search',
    label: 'Search',
    icon: 'search',
    ariaLabel: 'Search - 検索',
  },
  {
    href: '/docs',
    label: 'Dokumentasi',
    icon: 'dokumentasi',
    ariaLabel: 'Dokumentasi - ドキュメント',
  },
  {
    href: '/',
    label: 'Home',
    icon: 'home',
    ariaLabel: 'Home - ホーム',
  },
  {
    href: '/rekomendasi-channel-youtube-belajar-bahasa-jepang',
    label: 'Rekomendasi YT Jepang',
    icon: 'youtube',
    ariaLabel: 'Rekomendasi YT Jepang - おすすめチャンネル',
  },
  {
    href: '/project',
    label: 'Project',
    icon: 'spline-pointer',
    ariaLabel: 'Project - 語楽道プロジェクト',
  },
  {
    href: 'https://youtube.com/@yosiakefas',
    label: 'Subscribe YouTube',
    icon: 'subscribe',
    ariaLabel: 'Subscribe YouTube - チャンネル登録',
    target: '_blank',
  },
  {
    href: 'https://trakteer.id/yosiakefas/tip',
    label: 'Dukung Kami',
    icon: 'heart-plus',
    ariaLabel: 'Dukung Kami - サポート',
    target: '_blank',
