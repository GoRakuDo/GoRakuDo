---
// src/components/quest/DialogueBox.astro
// Dragon Quest-style dialogue window with typewriter animation.
// Typing mechanics live in the inline script below and expose a tiny
// imperative API (window.__questDialogue). The parent page drives the
// scenario: it calls showLine() and listens for 'quest:dialogue-activate'
// (click / Enter / Space) to decide complete-vs-advance.
//
// Accessibility: the visual text <p> is NOT a live region (typing would
// spam screen readers). A separate visually-hidden sibling <p> receives
// the full line text once per line via finish(), and the button references
// it with aria-describedby.
import '../../styles/pages/quest/quest.css';

interface Props {
  speakerName?: string;
  typingSpeedMs?: number;
  initialName?: string;
  initialText?: string;
}

const {
  speakerName = '???',
  typingSpeedMs = 30,
  initialName = speakerName,
  initialText = '',
} = Astro.props;
---

<div
  class='quest-dialogue'
  data-quest-dialogue
  data-typing-speed={String(typingSpeedMs)}
  tabindex='0'
  role='button'
  aria-label='Dialog: tekan Enter atau ketuk untuk lanjut'
  aria-describedby='quest-dialogue-live'
>
  <span class='quest-dialogue-name' data-quest-dialogue-name
    >{initialName}</span
  >
  <p class='quest-dialogue-text' data-quest-dialogue-text>{initialText}</p>
  <span class='quest-dialogue-next' aria-hidden='true'>▼</span>
</div>
<p
  class='quest-sr-only'
  id='quest-dialogue-live'
  data-quest-dialogue-live
  aria-live='polite'
  aria-atomic='true'
></p>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-quest-dialogue]');
    if (!root) return;
    const nameEl = root.querySelector('[data-quest-dialogue-name]');
    const textEl = root.querySelector('[data-quest-dialogue-text]');
    const liveEl = document.querySelector('[data-quest-dialogue-live]');
    if (!nameEl || !textEl) return;

    const speed =
      Number.parseInt(root.getAttribute('data-typing-speed') || '30', 10) ||
      30;
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = motionQuery.matches;
    if (typeof motionQuery.addEventListener === 'function') {
      motionQuery.addEventListener('change', (e) => {
        reduceMotion = e.matches;
      });
    }

    let fullText = '';
    let timer = null;
    let complete = true;

    const finish = () => {
      if (complete) return;
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      textEl.textContent = fullText;
      if (liveEl) liveEl.textContent = fullText;
      complete = true;
      root.classList.add('is-complete');
      root.dispatchEvent(
        new CustomEvent('quest:line-complete', { bubbles: true })
      );
    };

    const showLine = (line) => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      nameEl.textContent = line.name || '???';
      fullText = line.text || '';
      textEl.textContent = '';
      complete = false;
      root.classList.remove('is-complete');
      root.dispatchEvent(new CustomEvent('quest:line-start', { bubbles: true }));
      if (reduceMotion || fullText.length === 0) {
        finish();
        return;
      }
      let i = 0;
      timer = window.setInterval(() => {
        i += 1;
        textEl.textContent = fullText.slice(0, i);
        if (i >= fullText.length) finish();
      }, speed);
    };

    const activate = () => {
      root.dispatchEvent(
        new CustomEvent('quest:dialogue-activate', {
          bubbles: true,
          detail: { complete },
        })
      );
    };

    root.addEventListener('click', activate);
    root.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activate();
      }
    });

    window.__questDialogue = { showLine, finish, isComplete: () => complete };
  })();
</script>
